# Copy to demo.env and edit. Nothing else in this repo hardcodes cluster values.

DEMO_NAMESPACE="devspaces-demo"
DEVSPACES_NAMESPACE="openshift-devspaces"
DEVSPACES_CHANNEL="stable"

# Git org/user hosting the demo sample repos. Fork this repo and change GIT_ORG
# and the devfiles will point at your copy.
GIT_ORG="Deim0s13"
GIT_REPO="rhds-demo"
GIT_BRANCH="main"

# --- AI assistant backend ---------------------------------------------------
# Which model backend act 6 uses. The workspace only ever needs an
# OpenAI-compatible base URL, so switching backends is a variable change,
# not a fork of the demo.
#
#   rhoai   Serve on RHOAI / KServe with vLLM on GPU. Use this when you have a
#           GPU-enabled RHOAI environment, and especially when risk, security
#           or EA are in the room. Adds roughly 10 minutes to bootstrap.
#   ollama  Ollama pod, CPU, small model. The always-works fallback. Use this
#           on a plain cluster, when you are running to time, or when the
#           audience is app developers who care about the IDE, not the serving.
#   none    Skip act 6's AI segment entirely.
AI_BACKEND="rhoai"

# Name of the served model. This is the string the IDE assistant sends as
# "model", so it must match on both sides.
AI_MODEL="qwen2.5-coder-7b-instruct"

# Name of the InferenceService (rhoai) or Service (ollama).
AI_SERVICE_NAME="coder-model"

# --- rhoai backend only -----------------------------------------------------
# ModelCar OCI image carrying the weights. CONFIRM THIS TAG EXISTS before you
# rely on it; ModelCar catalogue tags move, and a bad reference fails at
# InferenceService startup rather than at apply time:
#   oc image info quay.io/redhat-ai-services/modelcar-catalog:<tag>
# If your environment has an internal mirror, point at that instead.
AI_MODEL_IMAGE="oci://quay.io/redhat-ai-services/modelcar-catalog:qwen2.5-coder-7b-instruct"

# Namespace RHOAI itself is installed into. Used for pre-flight checks only.
RHOAI_NAMESPACE="redhat-ods-applications"

# RHDP environments arrive with a sample model already served, holding the GPU.
# up.sh deletes namespaces on this allow-list, and ONLY these, when they are
# actually holding a GPU. Anything else gets a warning and is left alone, so the
# script stays safe to run on a shared or customer cluster.
# Space-separated. Add to it as you meet new environment templates.
RHDP_SAMPLE_NAMESPACES="my-first-model"

# Set to false to warn only and never delete anything.
FREE_GPU="true"

# --- ollama backend only ----------------------------------------------------
# Ignored unless AI_BACKEND=ollama.
OLLAMA_MODEL="qwen2.5-coder:1.5b"

# --- Internal Git (optional overlay) ----------------------------------------
# Stands up Gitea in-cluster so the demo can show developers cloning from an
# internal SCM with platform-provisioned credentials, rather than from a public
# repo. Gitea is a stand-in: your customers run Bitbucket Data Center or GitHub
# Enterprise. Say that out loud in the room, see docs/INTERNAL-GIT.md.
#
# Gitea is the demo's SCM: the samples are published into it as standalone
# repositories and workspaces clone from it over cluster-internal networking.
# This is the point of the demo, so it defaults on. Gitea needs no GPU and runs
# on any cluster. Turning it off leaves you with no repository URLs to create
# workspaces from.
DEPLOY_GITEA="true"

GITEA_ORG="platform-engineering"
GITEA_ADMIN_USER="platform-admin"
# Demo-only. Regenerate per environment; do not reuse across customers.
GITEA_ADMIN_PASSWORD="ChangeMe-PerEnvironment"
