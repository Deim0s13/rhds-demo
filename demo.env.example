# Copy to demo.env and edit. Nothing else in this repo hardcodes cluster values.
#
# demo.env is gitignored. Credentials for PostgreSQL, Redis and object storage
# are generated per cluster into ~/.config/rhds-demo/ and never live in the repo.

DEMO_NAMESPACE="devspaces-demo"
DEVSPACES_NAMESPACE="openshift-devspaces"
DEVSPACES_CHANNEL="stable"

# Source repo. Nothing clones this at demo time; it is the asset a colleague
# forks. The samples are published into GitLab by scripts/seed-gitlab.sh.
GIT_ORG="Deim0s13"
GIT_REPO="rhds-demo"
GIT_BRANCH="main"

# --- Internal Git -----------------------------------------------------------
# GitLab CE via the certified operator. It is one of the four SCM providers Dev
# Spaces actually supports (checluster.spec.gitServices), which Gitea is not:
# Dev Spaces cannot resolve a devfile from an unrecognised provider.
#
# Adds 30 to 45 minutes to a first bootstrap. Worth it: workspaces then clone
# from an internal SCM over cluster-internal networking, and act 6 can show a
# real per-user OAuth handshake rather than describing one.
DEPLOY_GITLAB="true"
GITLAB_NAMESPACE="gitlab-system"
GITLAB_GROUP="platform-engineering"

# Leave EMPTY to discover from the operator's admission webhook. The accepted
# chart list moves with each operator release (10.3.1 on one environment, 10.4.0
# three weeks later), so pinning goes stale and fails at admission.
GITLAB_CHART_VERSION=""

# Chart 10.x renders an EnvoyProxy resource even with gatewayApi disabled, so
# Envoy Gateway's CRDs must exist. Pinned because a moving target here is a
# rebuild that breaks with no change in the repo.
ENVOY_GATEWAY_VERSION="v1.2.1"

# GITLAB_HOST and CLUSTER_APPS_DOMAIN are discovered from the cluster.

# --- AI backend -------------------------------------------------------------
#   rhoai   vLLM on GPU via KServe. Needs an RHOAI environment with a free GPU.
#   ollama  CPU fallback, works on any cluster, about 5 minutes to stand up.
#   none    Skip the AI segment of act 6 entirely.
AI_BACKEND="rhoai"

AI_MODEL="llama-3.2-3b-instruct"
AI_SERVICE_NAME="coder-model"
RHOAI_NAMESPACE="redhat-ods-applications"

# ModelCar OCI image carrying the weights. CONFIRM THIS RESOLVES before relying
# on it: catalogue tags move, and a bad reference fails at InferenceService
# startup rather than at apply time. preflight.sh and up.sh both check it.
#   oc image info quay.io/redhat-ai-services/modelcar-catalog:<tag>
AI_MODEL_IMAGE="oci://quay.io/redhat-ai-services/modelcar-catalog:llama-3.2-3b-instruct"

# vLLM runtime image. Leave EMPTY to discover it from the cluster's own
# vllm-cuda-runtime-template. RHOAI ships runtime images matched to its version,
# and the digest differs between environments, so a pin will be wrong. A
# mismatched runtime fails deep in vLLM startup after an 18GB pull, looking like
# a model problem rather than a version problem.
AI_RUNTIME_IMAGE=""

# --- GPU --------------------------------------------------------------------
# RHDP environments arrive with a sample model holding the GPU. up.sh deletes
# namespaces on this allow-list, and ONLY these, when they actually hold a GPU.
# Anything else gets a warning and is left alone, so the script stays safe to run
# on a shared or customer cluster. Space-separated.
RHDP_SAMPLE_NAMESPACES="my-first-model"

# Set to false to warn only and never delete anything.
FREE_GPU="true"

# --- ollama backend only ----------------------------------------------------
OLLAMA_MODEL="qwen2.5-coder:1.5b"
